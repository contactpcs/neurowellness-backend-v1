# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret

# ── TimescaleDB (EEG reports) ─────────────────────────────────────────────────
TSDB_DATABASE_URL=postgres://tsdbadmin@gguyvxc03b.oiyo0zj1k9.tsdb.cloud.timescale.com:35472/tsdb?sslmode=require

# ── File Storage ──────────────────────────────────────────────────────────────
# Absolute or relative path where EEG PDFs are stored.
# Docker: map this to a persistent volume.
UPLOADS_DIR=uploads

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Admin bootstrap ───────────────────────────────────────────────────────────
BOOTSTRAP_SECRET_KEY=change-me

# ── Real-time / scheduling ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
SOCKETIO_CORS_ORIGINS=
RUN_SCHEDULER=true
